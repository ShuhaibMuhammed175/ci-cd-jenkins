        stage('Update Deployment File') {
          environment {
              GIT_REPO_NAME = "ci-cd-jenkins"
              GIT_USER_NAME = "ShuhaibMuhammed175"
          }

          steps {
              withCredentials([
                  string(credentialsId: 'github', variable: 'GITHUB_TOKEN')
              ]) {
                  sh '''
                      cd "$WORKSPACE"

                      git config --global --add safe.directory "$WORKSPACE"

                      git config user.email "mshuhaib175@gmail.com"
                      git config user.name "ShuhaibMuhammad"

                      DEPLOYMENT_FILE="Jenkins-Zero-To-Hero/java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml"

                      echo "Updating deployment image to build ${BUILD_NUMBER}"

                      sed -i "s|image: shuhaibmuhammad/ultimate-cicd:.*|image: shuhaibmuhammad/ultimate-cicd:${BUILD_NUMBER}|" "$DEPLOYMENT_FILE"

                      echo "Updated deployment image:"
                      grep "image:" "$DEPLOYMENT_FILE"

                      git add "$DEPLOYMENT_FILE"

                      git commit -m "Update deployment image to version ${BUILD_NUMBER}"

                      git push "https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git" HEAD:main
                  '''
              }
          }
      }
    }
}